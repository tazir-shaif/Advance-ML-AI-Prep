":"2026-11-06T07:46:35.60001Z","iopub.execute_input":"2026-11-06T07:46:35.600449Z","iopub.status.idle":"2026-11-06T07:46:35.613636Z","shell.execute_reply.started":"2026-11-06T07:46:35.600419Z","shell.execute_reply":"2026-11-06T07:46:35.612548Z"}},"outputs":[{"name":"stdout","text":"(16512, 13) (16512,)\n","output_type":"stream"}],"execution_count":35},{"cell_type":"code","source":"#Next we’re going to compute the steepness matrix H and its eigenvalues. Type this:\n\nn = len(yb)\nH = (2 / n) * Xb.T @ Xb\nlams = np.linalg.eigvalsh(H)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T07:46:35.614978Z","iopub.execute_input":"2026-11-06T07:46:35.616156Z","iopub.status.idle":"2026-11-06T07:46:35.643033Z","shell.execute_reply.started":"2026-11-06T07:46:35.616077Z","shell.execute_reply":"2026-11-06T07:46:35.641616Z"}},"outputs":[],"execution_count":36},{"cell_type":"code","source":"print(\"lambda max:\", lams.max().round(3))\nprint(\"lambda min:\", lams.min().round(5))\nprint(\"kappa (max/min):\", (lams.max() / lams.min()).round(0))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T07:46:35.644456Z","iopub.execute_input":"2026-11-06T07:46:35.644794Z","iopub.status.idle":"2026-11-06T07:46:35.666471Z","shell.execute_reply.started":"2026-11-06T07:46:35.644765Z","shell.execute_reply":"2026-11-06T07:46:35.664947Z"}},"outputs":[{"name":"stdout","text":"lambda max: 7.787\nlambda min: 0.0006\nkappa (max/min): 12895.0\n","output_type":"stream"}],"execution_count":37},{"cell_type":"markdown","source":"choose η from λmax = 7.787\nSpeed limit: η < 2 / 7.787 = 0.257. Anything above this explodes.\nGood starting choice: η = 1 / 7.787 ≈ 0.13 (a jump fraction of 1 in the steepest direction)\nA safe round number: η = 0.1","metadata":{}},{"cell_type":"markdown","source":"Here’s the detective work. The ISLAND one-hot column is not standardised (it’s 0/1) and is 1 in only 5 of 16,512 rows. Its steepness ≈ (2/n) × 5 = (2/16,512) × 5 ≈ 0.0006. That’s