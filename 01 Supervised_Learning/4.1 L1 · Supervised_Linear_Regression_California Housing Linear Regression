ion:\n    def __init__(self, method=\"normal\", eta=0.1, n_steps=500, batch_size=None):\n        self.method = method\n        self.eta = eta\n        self.n_steps = n_steps\n        self.batch_size = batch_size\n\n    def _add_bias(self, X):\n        return np.column_stack([np.ones(len(X)), X])\n\n    def fit(self, X, y):\n        Xb = self._add_bias(X)\n        if self.method == \"normal\":\n            self.w_, *_ = np.linalg.lstsq(Xb, y, rcond=None)\n        self.intercept_ = self.w_[0]\n        self.coef_ = self.w_[1:]\n        return self\n\n    def predict(self, X):\n        return self._add_bias(X) @ self.w_","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T09:45:50.836655Z","iopub.execute_input":"2026-11-06T09:45:50.837004Z","iopub.status.idle":"2026-11-06T09:45:50.844867Z","shell.execute_reply.started":"2026-11-06T09:45:50.836977Z","shell.execute_reply":"2026-11-06T09:45:50.843647Z"}},"outputs":[],"execution_count":64},{"cell_type":"code","source":"m = MyLinearRegression()\nprint(m.method, m.eta, m._add_bias(Xtr).shape)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T09:45:53.669812Z","iopub.execute_input":"2026-11-06T09:45:53.670456Z","iopub.status.idle":"2026-11-06T09:45:53.676421Z","shell.execute_reply.started":"2026-11-06T09:45:53.670427Z","shell.execute_reply":"2026-11-06T09:45:53.675483Z"}},"outputs":[{"name":"stdout","text":"normal 0.1 (16512, 13)\n","output_type":"stream"}],"execution_count":65},{"cell_type":"code","source":"m = MyLinearRegression(method=\"normal\").fit(Xtr, ytr)\nprint(\"intercept:\", round(m.intercept_))\nprint(\"first 3 predictions:\", m.predict(Xva[:3]).round(0))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T09:45:58.79322Z","iopub.execute_input":"2026-11-06T09:45:58.793774Z","iopub.status.idle":"2026-11-06T09:45:58.806021Z","shell.execute_reply.started":"2026-11-06T09:45:58.793741Z","shell.execute_reply":"2026-11-06T09:45:58.805175Z"}},"outputs":[{"name":"stdout","text":"intercept: 219658\nfirst 3 predictions: [208732.  95547. 212159.]\n","output_type":"stream"}],"execution_count":66},{"cell_type":"markdown","source":"Next we’re going to add gradient descent to fit","metadata":{}},{"cell_type":"code","source":"class MyLinearRegression:\n    def __init__(self, method=\"normal\", eta=0.1, n_steps=500, batch_size=None):\n        self.method = method\n        self.eta = eta\n        self.n_steps = n_steps\n        self.batch_size = batch_size\n\n    def _add_bias(self, X):\n        return np.column_stack([np.ones(len(X)), X])\n\n    def fit(self, X, y):\n        Xb = self._add_bias(X)\n        n = len(y)\n        if self.method == \"normal\":\n            self.w_, *_ = np.linalg.lstsq(Xb, y, rcond=None)\n        elif self.method == \"gd\":\n            rng = np.random.default_rng(42)\n            self.w_ = np.zeros(Xb.shape[1])\n            self.loss_history_ = []\n            for step in range(self.n_steps):\n                if self.batch_size is None:\n                    Xs, ys = Xb, y\n                else:\n                    idx = rng.choice(n, size=self.batch_size, replace=False)\n                    Xs, ys = Xb[idx], y[idx]\n                grad = (2 / len(ys)) * Xs.T @ (Xs @ self.w_ - ys)\n                self.w_ = self.w_ - self.eta * grad\n                self.loss_history_.append(np.mean((Xb @ self.w_ - y) ** 2))\n        else:\n            raise ValueError(\"method must be 'normal' or 'gd'\")\n        self.intercept_ = self.w_[0]\n        self.coef_ = self.w_[1:]\n        return self\n\n    def predict(self, X):\n        return self._add_bias(X) @ self.w_","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T09:47:17.37049Z","iopub.execute_input":"2026-11-06T09:47:17.370833Z","iopub.status.idle":"2026-11-06T09:47:17.381044Z","shell.execute_reply.started":"2026-11-06T09:47:17.370796Z","shell.execute_reply":"2026-11-06T09:47:17.379829Z"}},"outputs":[],"execution_count":67},{"cell_type":"code","source":"m_gd = MyLinearRegression(method=\"gd\", eta=0.1, n_steps=500).fit(Xtr, ytr)\nm_ne = MyLinearRegression(method=\"normal\").fit(Xtr, ytr)\n\nprint(\"GD intercept:\", round(m_gd.intercept_), \"  exact:\", round(m_ne.intercept_))\nprint(\"largest weight difference:\", round(np.abs(m_gd.w_ - m_ne.w_).max()))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T09:47:34.757805Z","iopub.execute_input":"2026-11-06T09:47:34.758722Z","iopub.status.idle":"2026-11-06T09:47:35.102827Z","shell.execute_reply.started":"2026-11-06T09:47:34.758688Z","shell.execute_reply":"2026-11-06T09:47:35.100982Z"}},"outputs":[{"name":"stdout","text":"GD intercept: 219857   exact: 219658\nlargest weight difference: 151845\n","output_type":"stream"}],"execution_count":68},{"cell_type":"code","source":"def rmse(y, p):\n    return np.sqrt(np.mean((y - p) ** 2))\n\ndef mae(y, p):\n    return np.mean(np.abs(y - p))\n\ndef r2(y, p):\n    sse = np.sum((y - p) ** 2)\n    sst = np.sum((y - y.mean()) ** 2)\n    return 1 - sse / sst","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T09:48:54.515009Z","iopub.execute_input":"2026-11-06T09:48:54.515409Z","iopub.status.idle":"2026-11-06T09:48:54.521831Z","shell.execute_reply.started":"2026-11-06T09:48:54.515377Z","shell.execute_reply":"2026-11-06T09:48:54.520871Z"}},"outputs":[],"execution_count":69},{"cell_type":"code","source":"p = m_ne.predict(Xva)\nprint(\"rmse:\", rmse(yva, p), np.sqrt(mean_squared_error(yva, p)))\nprint(\"mae: \", mae(yva, p), mean_absolute_error(yva, p))\nprint(\"r2:  \", r2(yva, p), r2_score(yva, p))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T09:49:15.937492Z","iopub.execute_input":"2026-11-06T09:49:15.938181Z","iopub.status.idle":"2026-11-06T09:49:15.949136Z","shell.execute_reply.started":"2026-11-06T09:49:15.938151Z","shell.execute_reply":"2026-11-06T09:49:15.948015Z"}},"outputs":[{"name":"stdout","text":"rmse: 68952.99672212065 68952.99672212065\nmae:  49841.66695788139 49841.66695788139\nr2:   0.6389493249380849 0.6389493249380849\n","output_type":"stream"}],"execution_count":70},{"cell_type":"code","source":"from sklearn.linear_model import LinearRegression   # sklearn's model, used as the \"correct answer\"\n\ndef test_normal_matches_sklearn():\n    mine = MyLinearRegression(method=\"normal\").fit(Xtr, ytr)   # fit my class (exact method)\n    sk = LinearRegression().fit(Xtr, ytr)                       # fit sklearn on the same data\n    # allclose = \"equal up to a tiny tolerance\"; rtol=1e-4 allows a 0.01% difference\n    assert np.allclose(mine.intercept_, sk.intercept_, rtol=1e-4)            # same intercept\n    assert np.allclose(mine.coef_, sk.coef_, rtol=1e-4)                      # same 12 weights\n    assert np.allclose(mine.predict(Xva), sk.predict(Xva), rtol=1e-4)       # same predictions\n\ndef test_gd_close_to_normal():\n    gd = MyLinearRegression(method=\"gd\", eta=0.1, n_steps=500).fit(Xtr, ytr)  # fit with gradient descent\n    ne = MyLinearRegression(method=\"normal\").fit(Xtr, ytr)                    # fit with exact method\n    rmse_gd = rmse(yva, gd.predict(Xva))    # validation error of the GD model\n    rmse_ne = rmse(yva, ne.predict(Xva))    # validation error of the exact model\n    # GD can't match the ISLAND weight in 500 steps, so test what matters:\n    # its validation RMSE must be within 1% of the exact solution's\n    assert abs(rmse_gd - rmse_ne) < 0.01 * rmse_ne\n\ndef test_shapes():\n    m = MyLinearRegression().fit(Xtr, ytr)              # default = exact method\n    assert m.predict(Xva).shape == (len(Xva),)          # one prediction per validation row\n    assert m.coef_.shape == (Xtr.shape[1],)             # one weight per feature (12)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T09:52:25.073801Z","iopub.execute_input":"2026-11-06T09:52:25.074106Z","iopub.status.idle":"2026-11-06T09:52:25.082763Z","shell.execute_reply.started":"2026-11-06T09:52:25.074081Z","shell.execute_reply":"2026-11-06T09:52:25.081874Z"}},"outputs":[],"execution_count":71},{"cell_type":"code","source":"test_normal_matches_sklearn()   # run test 1\ntest_gd_close_to_normal()       # run test 2\ntest_shapes()                   # run test 3\nprint(\"all tests passed\")       # only reached if none of the asserts failed","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T09:52:43.851359Z","iopub.execute_input":"2026-11-06T09:52:43.85166Z","iopub.status.idle":"2026-11-06T09:52:44.239186Z","shell.execute_reply.started":"2026-11-06T09:52:43.851636Z","shell.execute_reply":"2026-11-06T09:52:44.23815Z"}},"outputs":[{"name":"stdout","text":"all tests passed\n","output_type":"stream"}],"execution_count":72},{"cell_type":"markdown","source":"**Notes:**\n- `fit` adds a column of ones and solves least squares. The normal method uses `np.linalg.lstsq` rather than inverting XᵀX, which would square the condition number. The GD method repeats w ← w − η · (2/n) Xᵀ(Xw − y), using all rows (batch) or a random subset (mini-batch), and records the training MSE after each step.\n- The only Python loop is over GD steps; every step works on all rows at once with matrix operations.\n- My rmse, mae and r2 match scikit-learn to every printed digit. The normal method matches LinearRegression's intercept, coefficients and predictions within a relative tolerance of 1e-4 (validation RMSE 68,953, R² 0.639).\n- GD with η = 0.1 and 500 steps gets within 1 % of the exact validation RMSE. The ISLAND weight is still far from its exact value, because that direction is very flat (only 5 rows), so I test GD on predictions rather than on that weight.","metadata":{}},{"cell_type":"markdown","source":"### 13. Gradient-descent experiments\n\nUsing my own class from section 12, I check how the learning rate, feature scaling and batch size change convergence, and whether the stability limit η < 2/λmax holds on this data (λmax = 7.787 from section 10, so the limit is about 0.257).","metadata":{}},{"cell_type":"markdown","source":"","metadata":{}},{"cell_type":"code","source":"etas = [0.01, 0.1, 0.25]                       # small, medium, close to the limit (0.257)\n\nfor eta in etas:\n    m = MyLinearRegression(method=\"gd\", eta=eta, n_steps=300).fit(Xtr, ytr)   # batch GD\n    plt.plot(np.sqrt(m.loss_history_), label=f\"eta = {eta}\")                 # RMSE per step\n\nplt.yscale(\"log\")                              # log scale shows the early drop and the slow tail\nplt.xlabel(\"step\"); plt.ylabel(\"train RMSE\")\nplt.title(\"Batch GD with three learning rates\")\nplt.legend()                                   # shows which colour is which eta\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T09:55:17.708279Z","iopub.execute_input":"2026-11-06T09:55:17.708621Z","iopub.status.idle":"2026-11-06T09:55:18.586863Z","shell.execute_reply.started":"2026-11-06T09:55:17.708595Z","shell.execute_reply":"2026-11-06T09:55:18.585971Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":73},{"cell_type":"markdown","source":"Next: experiment 2 on your real data. λmax = 7.787, so the limit is 2/7.787 ≈ 0.257. We’ll run:\n\nη = 0.25 (just below the limit) → should settle\nη = 0.26 (just above the limit) → should explode","metadata":{}},{"cell_type":"code","source":"for eta in [0.25, 0.26]:                                   # just below and just above 2/λmax ≈ 0.257\n    m = MyLinearRegression(method=\"gd\", eta=eta, n_steps=500).fit(Xtr, ytr)\n    rmse_curve = np.sqrt(m.loss_history_)                  # train RMSE after each step\n    print(f\"eta {eta}:  step 50 {rmse_curve[49]:,.0f}   step 200 {rmse_curve[199]:,.0f}   step 500 {rmse_curve[499]:,.0f}\")\n    plt.plot(rmse_curve, label=f\"eta = {eta}\")\n\nplt.yscale(\"log\")\nplt.xlabel(\"step\"); plt.ylabel(\"train RMSE\")\nplt.title(\"Just below vs just above the stability limit\")\nplt.legend()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T10:13:03.804632Z","iopub.execute_input":"2026-11-06T10:13:03.805013Z","iopub.status.idle":"2026-11-06T10:13:04.856953Z","shell.execute_reply.started":"2026-11-06T10:13:03.804984Z","shell.execute_reply":"2026-11-06T10:13:04.855882Z"}},"outputs":[{"name":"stdout","text":"eta 0.25:  step 50 68,919   step 200 68,705   step 500 68,700\neta 0.26:  step 50 72,945   step 200 930,067   step 500 1,389,491,077\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":74},{"cell_type":"markdown","source":"**Notes (stability limit):** With λmax = 7.787 the theory says GD is stable only for η < 2/7.787 ≈ 0.257. At η = 0.25 the train RMSE settles at 68,700. At η = 0.26 it drops for the first ~50 steps (the gentle directions still improve) and then grows without bound, reaching 1.39 billion by step 500. On the log plot the growth is a straight line, about ×1.025 per step, which matches |1 − 0.26 × 7.787| ≈ 1.025. So the measured threshold is between 0.25 and 0.26, as predicted.","metadata":{}},{"cell_type":"markdown","source":"Next we’re going to build raw and standardised versions of the same 8 numeric features.","metadata":{}},{"cell_type":"code","source":"med = X_train[num_cols].median()                              # median of each numeric column (train only)\nXraw_tr = X_train[num_cols].fillna(med).to_numpy()            # raw numbers, missing values filled\nXstd_tr = (Xraw_tr - Xraw_tr.mean(axis=0)) / Xraw_tr.std(axis=0)   # same columns, standardised\n\ndef steepness(X):\n    Xb = np.column_stack([np.ones(len(X)), X])                # add the bias column\n    lams = np.linalg.eigvalsh((2 / len(X)) * Xb.T @ Xb)       # steepness in every direction\n    return lams.max(), lams.max() / lams.min()                # λmax, and κ = steepest / flattest","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T10:16:31.94961Z","iopub.execute_input":"2026-11-06T10:16:31.950601Z","iopub.status.idle":"2026-11-06T10:16:31.97182Z","shell.execute_reply.started":"2026-11-06T10:16:31.950558Z","shell.execute_reply":"2026-11-06T10:16:31.970407Z"}},"outputs":[],"execution_count":75},{"cell_type":"code","source":"for name, X_ in [(\"raw\", Xraw_tr), (\"standardised\", Xstd_tr)]:\n    lam_max, kappa = steepness(X_)\n    print(f\"{name:>13}:  lambda max {lam_max:,.3g}   safe eta < {2 / lam_max:.3g}   kappa {kappa:,.3g}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T10:16:40.966378Z","iopub.execute_input":"2026-11-06T10:16:40.966857Z","iopub.status.idle":"2026-11-06T10:16:40.976916Z","shell.execute_reply.started":"2026-11-06T10:16:40.966825Z","shell.execute_reply":"2026-11-06T10:16:40.975926Z"}},"outputs":[{"name":"stdout","text":"          raw:  lambda max 3.11e+07   safe eta < 6.43e-08   kappa 2.56e+11\n standardised:  lambda max 7.79   safe eta < 0.257   kappa 193\n","output_type":"stream"}],"execution_count":76},{"cell_type":"markdown","source":"Next we’re going to run GD on both versions, 1,000 steps each.","metadata":{}},{"cell_type":"code","source":"exact = MyLinearRegression(method=\"normal\").fit(Xstd_tr, ytr)       # the true best answer\nbest = rmse(ytr, exact.predict(Xstd_tr))                            # its train RMSE (same for raw or scaled)\nprint(f\"exact solution: {best:,.0f}\")\n\nfor name, X_ in [(\"raw\", Xraw_tr), (\"standardised\", Xstd_tr)]:\n    lam_max, _ = steepness(X_)                                      # steepness of this version's valley\n    m = MyLinearRegression(method=\"gd\", eta=1 / lam_max, n_steps=1000).fit(X_, ytr)   # safe eta = 1/λmax\n    curve = np.sqrt(m.loss_history_)                                 # train RMSE per step\n    print(f\"{name:>13}:  after 1000 steps {curve[-1]:,.0f}   gap to exact {curve[-1] - best:,.0f}\")\n    plt.plot(curve, label=name)\n\nplt.axhline(best, color=\"black\", linestyle=\"--\", label=\"exact solution\")   # target line\nplt.yscale(\"log\")\nplt.xlabel(\"step\"); plt.ylabel(\"train RMSE\")\nplt.title(\"GD on raw vs standardised features\")\nplt.legend()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T10:19:41.494651Z","iopub.execute_input":"2026-11-06T10:19:41.494983Z","iopub.status.idle":"2026-11-06T10:19:42.429519Z","shell.execute_reply.started":"2026-11-06T10:19:41.494954Z","shell.execute_reply":"2026-11-06T10:19:42.428558Z"}},"outputs":[{"name":"stdout","text":"exact solution: 69,647\n          raw:  after 1000 steps 136,403   gap to exact 66,755\n standardised:  after 1000 steps 69,647   gap to exact 0\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":77},{"cell_type":"markdown","source":"**Notes (raw vs standardised):** On the same 8 numeric features, the raw valley has λmax = 3.1e7 and κ = 2.6e11, while the standardised one has λmax = 7.79 and κ = 193. With each version's own safe step (η = 1/λmax) and 1,000 steps, standardised GD reaches the exact train RMSE of 69,647 within about 100 steps, while raw GD is still at 136,403. The raw step size has to be tiny to stay stable in the steepest direction, so the flat directions hardly move. Standardising is essential for gradient descent.","metadata":{}},{"cell_type":"markdown","source":"experiment 4, batch vs SGD vs mini-batch. We’ll use the same standardised data with three batch sizes (all rows, 1 row, 256 rows) and compare how smooth and how fast each loss curve is.","metadata":{}},{"cell_type":"code","source":"runs = [(\"batch (all rows)\", None, 0.1),       # name, batch_size, eta\n        (\"mini-batch (256)\", 256, 0.1),\n        (\"SGD (1 row)\",      1,   0.001)]      # single rows can be extreme, so SGD needs a much smaller eta\n\nfor name, bs, eta in runs:\n    m = MyLinearRegression(method=\"gd\", eta=eta, n_steps=2000, batch_size=bs).fit(Xstd_tr, ytr)\n    curve = np.sqrt(m.loss_history_)                         # full train RMSE after each step\n    print(f\"{name:>17}:  step 100 {curve[99]:,.0f}   step 2000 {curve[-1]:,.0f}\")\n    plt.plot(curve, label=name, alpha=0.8)\n\nplt.axhline(best, color=\"black\", linestyle=\"--\", label=\"exact solution\")\nplt.yscale(\"log\")\nplt.xlabel(\"step\"); plt.ylabel(\"train RMSE\")\nplt.title(\"Batch vs mini-batch vs SGD\")\nplt.legend()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T10:22:37.265734Z","iopub.execute_input":"2026-11-06T10:22:37.266362Z","iopub.status.idle":"2026-11-06T10:22:38.912302Z","shell.execute_reply.started":"2026-11-06T10:22:37.266322Z","shell.execute_reply":"2026-11-06T10:22:38.911341Z"}},"outputs":[{"name":"stdout","text":" batch (all rows):  step 100 70,101   step 2000 69,647\n mini-batch (256):  step 100 70,307   step 2000 69,917\n      SGD (1 row):  step 100 198,232   step 2000 75,738\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":78},{"cell_type":"markdown","source":"![image.png](attachment:7a0c9e7a-a7b6-40c3-833a-b09f3c951a56.png)","metadata":{},"attachments":{"7a0c9e7a-a7b6-40c3-833a-b09f3c951a56.png":{"image/png":""}}},{"cell_type":"markdown","source":"**Notes (batch vs mini-batch vs SGD):** Batch GD (η = 0.1) reaches the exact train RMSE of 69,647 smoothly. Mini-batch with 256 rows and the same η is just as fast and ends at 69,917, but shows spikes when a batch happens to contain extreme districts; a decaying learning rate would remove them. Single-row SGD needs a much smaller step (η = 0.001), because one extreme row can produce a huge update, and after 2,000 steps it is at 75,738 with visible jumps. It has only seen 2,000 rows in total, about 12 % of one epoch, so it does far less work per step. Mini-batch gives most of batch's accuracy at a fraction of the cost per step.","metadata":{}},{"cell_type":"markdown","source":"Next we’re going to time the exact solve vs GD as the number of rows grows","metadata":{}},{"cell_type":"code","source":"import time                                            # for the stopwatch\n\nrng = np.random.default_rng(0)                         # fixed seed: same fake data every run\nd = 20                                                 # 20 features, kept fixed\n\nfor n in [1_000, 10_000, 100_000, 500_000]:            # number of rows grows ×10, ×10, ×5\n    Xs = rng.normal(size=(n, d))                       # fake features (already \"standardised\")\n    ys = Xs @ rng.normal(size=d) + rng.normal(size=n)  # fake target = weighted sum + noise\n\n    t0 = time.perf_counter()                           # start the stopwatch\n    MyLinearRegression(method=\"normal\").fit(Xs, ys)\n    t_exact = time.perf_counter() - t0                 # seconds taken\n\n    t0 = time.perf_counter()\n    MyLinearRegression(method=\"gd\", eta=0.1, n_steps=200).fit(Xs, ys)\n    t_gd = time.perf_counter() - t0\n\n    print(f\"n = {n:>7,}:  exact {t_exact:.3f} s   GD (200 steps) {t_gd:.3f} s\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T10:27:30.866156Z","iopub.execute_input":"2026-11-06T10:27:30.866507Z","iopub.status.idle":"2026-11-06T10:27:47.764075Z","shell.execute_reply.started":"2026-11-06T10:27:30.866483Z","shell.execute_reply":"2026-11-06T10:27:47.763438Z"}},"outputs":[{"name":"stdout","text":"n =   1,000:  exact 0.002 s   GD (200 steps) 0.016 s\nn =  10,000:  exact 0.009 s   GD (200 steps) 0.139 s\nn = 100,000:  exact 0.080 s   GD (200 steps) 2.015 s\nn = 500,000:  exact 0.432 s   GD (200 steps) 13.864 s\n","output_type":"stream"}],"execution_count":79},{"cell_type":"markdown","source":"When does GD win, then?\n\nWhen d (the number of features) becomes huge. The exact method’s cost includes d³: double d and it does 8× the work. GD’s cost per step only grows with d.","metadata":{}},{"cell_type":"code","source":"n = 4_000                                              # rows kept fixed this time\n\nfor d in [50, 200, 800, 1_600]:                        # features grow ×4, ×4, ×2\n    Xs = rng.normal(size=(n, d))\n    ys = Xs @ rng.normal(size=d) + rng.normal(size=n)\n\n    t0 = time.perf_counter()\n    MyLinearRegression(method=\"normal\").fit(Xs, ys)\n    t_exact = time.perf_counter() - t0\n\n    t0 = time.perf_counter()\n    MyLinearRegression(method=\"gd\", eta=0.1, n_steps=200).fit(Xs, ys)\n    t_gd = time.perf_counter() - t0\n\n    print(f\"d = {d:>5,}:  exact {t_exact:.3f} s   GD (200 steps) {t_gd:.3f} s\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-06T10:30:26.998101Z","iopub.execute_input":"2026-11-06T10:30:26.999489Z","iopub.status.idle":"2026-11-06T10:30:37.192708Z","shell.execute_reply.started":"2026-11-06T10:30:26.999436Z","shell.execute_reply":"2026-11-06T10:30:37.191736Z"}},"outputs":[{"name":"stdout","text":"d =    50:  exact 0.031 s   GD (200 steps) 0.107 s\nd =   200:  exact 0.062 s   GD (200 steps) 0.296 s\nd =   800:  exact 0.509 s   GD (200 steps) 1.660 s\nd = 1,600:  exact 1.831 s   GD (200 steps) 5.420 s\n","output_type":"stream"}],"execution_count":80},{"cell_type":"markdown","source":"**Conclusions:** On standardised California features, λmax = 7.79 sets the stability limit for gradient descent at η < 0.257. I confirmed it directly: η = 0.25 converges, while η = 0.26 diverges at about ×1.025 per step, as predicted. The largest stable η converges fastest, because the flat directions limit the speed. Without standardisation the valley has λmax = 3.1e7 and κ = 2.6e11, so after 1,000 steps GD is still at twice the best RMSE, while the standardised version gets there in about 100 steps. Mini-batches of 256 match batch GD's progress at a much lower cost per step but show spikes from extreme districts (a decaying η would help); single-row SGD needs a tiny η and is noisy. The exact solver scales linearly in n and faster than linearly in d. For d up to a few thousand it is much faster than GD, which only wins when d is so large that XᵀX no longer fits in memory.","metadata":{}},{"cell_type":"markdown","source":"","metadata":{}}]}