908.png":{"image/png":""}}},{"cell_type":"code","source":"def gradient_l2(X, y, p, w, lambda_l2):\n    \n    n = len(y)\n\n    # Original logistic regression gradient\n    grad = X.T @ (p - y) / n\n\n    # L2 penalty gradient\n    penalty = lambda_l2 * w.copy()\n\n    # Do not regularize the bias\n    penalty[0] = 0\n\n    return grad + penalty","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T08:03:04.416979Z","iopub.execute_input":"2026-11-24T08:03:04.417276Z","iopub.status.idle":"2026-11-24T08:03:04.439814Z","shell.execute_reply.started":"2026-11-24T08:03:04.417245Z","shell.execute_reply":"2026-11-24T08:03:04.438315Z"}},"outputs":[],"execution_count":39},{"cell_type":"markdown","source":"![image.png](attachment:3acd7882-4018-42aa-b680-28f74f41be67.png)","metadata":{},"attachments":{"3acd7882-4018-42aa-b680-28f74f41be67.png":{"image/png":""}}},{"cell_type":"code","source":"# Start a new regularized model from zero\nw30_l2 = np.zeros(X30_train_b.shape[1])\n\nlr_l2 = 0.1\nsteps_l2 = 20000\n\nfor step in range(steps_l2):\n\n    # 1. Linear score\n    z = X30_train_b @ w30_l2\n\n    # 2. Predicted probabilities\n    p = sigmoid(z)\n\n    # 3. Gradient including L2\n    grad = gradient_l2(\n        X30_train_b,\n        y_train_np,\n        p,\n        w30_l2,\n        lambda_l2\n    )\n\n    # 4. Update parameters\n    w30_l2 = w30_l2 - lr_l2 * grad\n\n    # 5. Monitor every 2000 steps\n    if step % 2000 == 0:\n\n        z_now = X30_train_b @ w30_l2\n\n        data_loss = log_loss_stable(\n            y_train_np,\n            z_now\n        )\n\n        weight_norm = np.linalg.norm(w30_l2[1:])\n\n        print(\n            f\"Step {step:5d} | \"\n            f\"Data loss = {data_loss:.6f} | \"\n            f\"||w|| = {weight_norm:.4f}\"\n        )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T08:03:04.441185Z","iopub.execute_input":"2026-11-24T08:03:04.441533Z","iopub.status.idle":"2026-11-24T08:03:05.141283Z","shell